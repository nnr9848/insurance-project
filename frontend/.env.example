# ==============================================================================
# Aadhiraksha Insurance - Frontend Environment Configuration
# ==============================================================================

# API Base URL (defaults to '/api' for proxy in dev, or VPS URL)
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# Firebase Phone Authentication (SMS OTP)
# Get these keys from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderAPIKeyHere123456789
VITE_FIREBASE_AUTH_DOMAIN=aadhiraksha-insurance.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aadhiraksha-insurance
VITE_FIREBASE_STORAGE_BUCKET=aadhiraksha-insurance.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
